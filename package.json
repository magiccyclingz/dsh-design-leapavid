{
  "name": "dsh-design-md",
  "version": "1.10.0",
  "type": "module",
  "description": "84 套来自 getdesign.md 的品牌设计语言：在左侧栏浏览网页亮/暗、幻灯片与海报案例，一键把选中的风格连同 token 送进当前会话，由 DSH 生成网页 / 幻灯片 / 海报。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "locale/*.md",
    "THIRD-PARTY-NOTICES.md",
    "README.md",
    "CHANGELOG.md",
    "icon.svg",
    "data"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "license": "MIT",
  "author": "LeapAvid",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "design",
    "design-system",
    "design-tokens",
    "brand",
    "getdesign-md",
    "web-ui"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test",
    "build": "node build/build-data.mjs"
  }
}
